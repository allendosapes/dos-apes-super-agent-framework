      "Bash(rm -rf ~*)",
      "Bash(rm -rf ..*)",
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)"
    ]
  },

  "env": {
    "DOS_APES_FRAMEWORK": "true",
    "DOS_APES_VERSION": "3.5.1",
    "DOS_APES_GATE_SCRIPT": "scripts/check-task-gates.sh"
  }
